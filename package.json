{
  "name": "nr-fom",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=26.0.0 || ^24.15.0 || ^22.22.3"
  },
  "workspaces": [
    "libs",
    "public",
    "admin",
    "api"
  ],
  "scripts": {
    "build:public": "npm run build:public --workspace=public",
    "build:admin": "npm run build:admin --workspace=admin",
    "build:api": "npm run build:api --workspace=api",
    "start:public": "npm run start:public --workspace=public",
    "start:admin": "npm run start:admin --workspace=admin",
    "start:api": "npm run start:api --workspace=api",
    "test:public": "npm run test-unit --workspace=public",
    "test:admin": "npm run test-unit --workspace=admin",
    "test:api": "npm run test-unit --workspace=api"
  },
  "overrides": {
    "ngx-bootstrap": {
      "@angular/core": "^22.0.1",
      "@angular/common": "^22.0.1",
      "@angular/forms": "^22.0.1"
    },
    "nodemailer": "^9.0.5",
    "typeorm": "^1.0.0",
    "@nestjs/typeorm": {
      "typeorm": "^1.0.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    },
    "linkify-it": "^5.0.2"
  }
}
