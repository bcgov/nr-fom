export SECURITY_ENABLED='true'
# BC Gov SSO (Keycloak) dev realm, and FOM's CSS integration client id. Required
# while SECURITY_ENABLED is 'true'; the dev integration must list
# http://localhost:4200/admin/search and http://localhost:4200/admin/logout.
export KEYCLOAK_ISSUER_URI='https://dev.loginproxy.gov.bc.ca/auth/realms/standard'
export KEYCLOAK_CLIENT_ID=''

# Environment variable settings needed to run API locally via npm run start:api
export BYPASS_CORS='true'
export DB_TESTDATA='true'
export OBJECT_STORAGE_URL='nrs.objectstore.gov.bc.ca'
export OBJECT_STORAGE_ACCESS_ID='nr-fom-dev'
